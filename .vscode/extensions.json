{
  "recommendations": [
    // Linting and formatting (oxlint + oxfmt)
    "oxc.oxc-vscode",
    // Kirana's language server, for the corpus
    "kirana-style.kirana"

    // TypeScript / React
    // "ms-vscode.vscode-typescript-next",

    // Bun runtime support
    // "oven.bun-vscode"
  ],
  "unwantedRecommendations": [
    // Replaced by oxfmt and oxlint — leaving these installed means two
    // formatters fighting over the same files on save.
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",

    // The corpus is Kirana, and the Tailwind baseline is kept as written, never
    // edited here: the Tailwind extension would only report the corpus's style
    // objects as unknown classes.
    "bradlc.vscode-tailwindcss"
  ]
}
